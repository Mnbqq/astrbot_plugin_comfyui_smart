{
  "name": "wan_t2v",
  "purpose": "t2v",
  "arch": "generic",
  "loader": "unet",
  "description": "文生视频（Wan 2.x 原生支持）：UNETLoader + CLIPLoader(type=wan) + VAELoader + EmptyHunyuanLatentVideo + ModelSamplingSD3 + KSampler + VAEDecode + SaveWEBM。帧数（length）与帧率（fps）由 /视频 的 --seconds/--fps 算好写进来；尺寸走 Wan 档案（832x480）。需要 ComfyUI 里已装好 Wan 模型：diffusion_models 里的 wan*.safetensors、text_encoders 里的 umt5_xxl*、vae 里的 wan_2.1_vae.safetensors。",
  "params": {
    "length": "6",
    "fps": "10"
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "_meta": { "title": "Wan 底模（diffusion_models）" },
      "inputs": { "unet_name": "wan2.1_t2v_1.3B_fp16.safetensors", "weight_dtype": "default" }
    },
    "2": {
      "class_type": "CLIPLoader",
      "_meta": { "title": "文本编码器（umt5）" },
      "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan" }
    },
    "3": {
      "class_type": "VAELoader",
      "_meta": { "title": "VAE" },
      "inputs": { "vae_name": "wan_2.1_vae.safetensors" }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "正面提示词" },
      "inputs": { "text": "", "clip": ["2", 0] }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "负面提示词" },
      "inputs": { "text": "", "clip": ["2", 0] }
    },
    "6": {
      "class_type": "EmptyHunyuanLatentVideo",
      "_meta": { "title": "尺寸与帧数" },
      "inputs": { "width": 832, "height": 480, "length": 81, "batch_size": 1 }
    },
    "7": {
      "class_type": "ModelSamplingSD3",
      "_meta": { "title": "Wan 采样偏移" },
      "inputs": { "model": ["1", 0], "shift": 8.0 }
    },
    "8": {
      "class_type": "KSampler",
      "_meta": { "title": "采样器" },
      "inputs": {
        "model": ["7", 0],
        "seed": 0,
        "steps": 30,
        "cfg": 6.0,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "positive": ["4", 0],
        "negative": ["5", 0],
        "latent_image": ["6", 0],
        "denoise": 1.0
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "_meta": { "title": "VAE 解码" },
      "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
    },
    "10": {
      "class_type": "SaveWEBM",
      "_meta": { "title": "保存视频（webm）" },
      "inputs": {
        "images": ["9", 0],
        "filename_prefix": "astrbot_video",
        "codec": "vp9",
        "fps": 16.0,
        "crf": 32.0
      }
    }
  }
}
