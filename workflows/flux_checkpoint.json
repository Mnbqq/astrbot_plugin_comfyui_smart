{
  "name": "flux_checkpoint",
  "arch": "flux",
  "loader": "checkpoint",
  "description": "一体化 FLUX.1 单文件 Checkpoint（模型/文本编码器/VAE 打包在一起）。CFG 固定 1.0，负向提示词不生效，引导强度走 FluxGuidance。",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "底模 Checkpoint"
      },
      "inputs": {
        "ckpt_name": "put_your_flux_checkpoint_here.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "正面提示词"
      },
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "负面提示词（Flux 不生效）"
      },
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "FluxGuidance",
      "_meta": {
        "title": "Flux 引导强度"
      },
      "inputs": {
        "conditioning": [
          "2",
          0
        ],
        "guidance": 3.5
      }
    },
    "5": {
      "class_type": "EmptySD3LatentImage",
      "_meta": {
        "title": "尺寸"
      },
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "6": {
      "class_type": "KSampler",
      "_meta": {
        "title": "采样器"
      },
      "inputs": {
        "model": [
          "1",
          0
        ],
        "seed": 0,
        "steps": 20,
        "cfg": 1.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "positive": [
          "4",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "5",
          0
        ],
        "denoise": 1.0
      }
    },
    "7": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE 解码"
      },
      "inputs": {
        "samples": [
          "6",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "8": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "保存图片"
      },
      "inputs": {
        "images": [
          "7",
          0
        ],
        "filename_prefix": "astrbot_smart_flux"
      }
    }
  }
}
