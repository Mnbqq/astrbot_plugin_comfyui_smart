{
  "name": "sd_checkpoint",
  "arch": "generic",
  "loader": "checkpoint",
  "description": "SD1.5 / SDXL / Pony / Illustrious 等单文件 Checkpoint 通用图。分辨率、CFG、采样器、步数由架构档案注入。",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "底模 Checkpoint"
      },
      "inputs": {
        "ckpt_name": "put_your_checkpoint_here.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "正面提示词"
      },
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "负面提示词"
      },
      "inputs": {
        "text": "",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "_meta": {
        "title": "尺寸"
      },
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "5": {
      "class_type": "KSampler",
      "_meta": {
        "title": "采样器"
      },
      "inputs": {
        "model": [
          "1",
          0
        ],
        "seed": 0,
        "steps": 28,
        "cfg": 6.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "4",
          0
        ],
        "denoise": 1.0
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE 解码"
      },
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "_meta": {
        "title": "保存图片"
      },
      "inputs": {
        "images": [
          "6",
          0
        ],
        "filename_prefix": "astrbot_smart"
      }
    }
  }
}
